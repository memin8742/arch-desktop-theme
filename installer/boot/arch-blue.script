screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
wall = Image("wallpaper.png");
ratio_x = screen_width / wall.GetWidth();
ratio_y = screen_height / wall.GetHeight();
if (ratio_y > ratio_x) ratio_x = ratio_y;
wall = wall.Scale(Math.Int(wall.GetWidth() * ratio_x), Math.Int(wall.GetHeight() * ratio_x));
background = Sprite(wall);
background.SetX((screen_width - wall.GetWidth()) / 2);
background.SetY((screen_height - wall.GetHeight()) / 2);
background.SetZ(-100);

track = Image("track.png");
fill = Image("fill.png");
bar_width = 152;
bar_x = (screen_width - bar_width) / 2;
bar_y = screen_height * 0.878;
track_sprite = Sprite(track.Scale(bar_width, 2));
track_sprite.SetPosition(bar_x, bar_y, 2);
fill_sprite = Sprite(fill);
fill_sprite.SetPosition(bar_x, bar_y, 3);
# Keep Turkish glyphs independent of the early boot locale and fonts.
caption_image = Image("boot-caption.png");
caption = Sprite(caption_image);
caption.SetPosition((screen_width - caption_image.GetWidth()) / 2, bar_y + 13, 4);

fun progress_callback (duration, percent)
{
    width = Math.Int(percent * bar_width);
    if (width < 1) width = 1;
    if (width > bar_width) width = bar_width;
    fill_sprite.SetImage(fill.Scale(width, 2));
}
Plymouth.SetBootProgressFunction(progress_callback);
